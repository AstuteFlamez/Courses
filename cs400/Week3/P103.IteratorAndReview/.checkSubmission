#!/usr/bin/env bash

JUNITPATH="/libs/junit5.jar"

if [[ -f ${JUNITPATH} ]]; then
    cp ${JUNITPATH} ../
fi

if ! javac -cp ../junit5.jar:src *.java; then
    echo
    echo "Submission Failed Check: cannot compile IterableRedBlackTree.java or P103SubmissionChecker.java"
    exit 1
fi

if ! java -jar ../junit5.jar --class-path=src --select-class=P103SubmissionChecker; then
    echo
    echo "Submission Failed Check: one or more JUnit tests failed"
    exit 1
fi

echo
echo "Submission Passed Basic Scan"
exit 0
